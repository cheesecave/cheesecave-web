{
  "schemaVersion": 2,
  "name": "动漫脸部检测",
  "task": {
    "preset": "anime-face-v1",
    "version": 1,
    "model": "face_detect_v1.4_n",
    "sample": "mostima",
    "params": {
      "threshold": 0.8,
      "backend": "auto",
      "iou": 0.7,
      "repeats": 1
    }
  },
  "bindings": {
    "image": "image",
    "threshold": "threshold",
    "backend": "backend",
    "result": "detections"
  },
  "ui": {
    "options": {
      "form": {
        "labelPosition": "top",
        "labelWidth": "120px",
        "size": "default"
      },
      "submitBtn": false,
      "resetBtn": false
    },
    "rules": [
      {
        "type": "ccHeading",
        "props": {
          "text": "发现画面中的每一张脸",
          "level": 2
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "ccText",
        "props": {
          "text": "选择图片，调整置信度，然后开始检测。"
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "ccImageInput",
        "field": "image",
        "props": {
          "title": "输入图片",
          "description": "选择或拖入图片，也可以使用示例",
          "showSample": true
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "slider",
        "field": "threshold",
        "title": "置信度阈值",
        "value": 0.8,
        "col": {
          "span": 14,
          "xs": 24
        },
        "props": {
          "min": 0.01,
          "max": 1,
          "step": 0.001,
          "showInput": true
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "select",
        "field": "backend",
        "title": "执行后端",
        "value": "auto",
        "col": {
          "span": 10,
          "xs": 24
        },
        "options": [
          {
            "label": "自动选择",
            "value": "auto"
          },
          {
            "label": "WebGPU",
            "value": "webgpu"
          },
          {
            "label": "WASM · CPU",
            "value": "wasm"
          }
        ],
        "display": true,
        "hidden": false
      },
      {
        "type": "ccActionButton",
        "props": {
          "actionId": "run",
          "label": "开始检测",
          "type": "primary"
        },
        "col": {
          "span": 24
        },
        "wrap": {
          "show": false
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "ccDetectionResult",
        "field": "detections",
        "props": {
          "title": "检测结果",
          "showScores": true
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "ccInferenceStatus",
        "props": {
          "title": "运行与测量",
          "showDetails": true,
          "showHistory": true
        },
        "display": true,
        "hidden": false
      },
      {
        "type": "ccButton",
        "props": {
          "actionId": "resetParameters",
          "label": "重置参数",
          "type": "default"
        },
        "wrap": {
          "show": false
        },
        "display": true,
        "hidden": false
      }
    ]
  }
}
